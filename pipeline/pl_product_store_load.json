{
	"name": "pl_product_store_load",
	"properties": {
		"activities": [
			{
				"name": "Copy Products data to SQL table",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"additionalColumns": [
							{
								"name": "LoadedAt",
								"value": {
									"value": "@utcNow()",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "upsert",
						"upsertSettings": {
							"useTempDB": true,
							"keys": [
								"SKU"
							]
						},
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"enableSkipIncompatibleRow": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "['sku']"
								},
								"sink": {
									"name": "SKU",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['productName']"
								},
								"sink": {
									"name": "ProductName",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['category']"
								},
								"sink": {
									"name": "Category",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['listPrice']"
								},
								"sink": {
									"name": "ListPrice",
									"type": "Decimal"
								}
							},
							{
								"source": {
									"path": "['attributes']['brand']"
								},
								"sink": {
									"name": "Brand",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['LoadedAt']"
								},
								"sink": {
									"name": "LoadedAt",
									"type": "DateTime"
								}
							}
						],
						"collectionReference": "$['products']",
						"mapComplexValuesToString": false
					}
				},
				"inputs": [
					{
						"referenceName": "ds_json_products",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_sql_table",
						"type": "DatasetReference",
						"parameters": {
							"table_name": "DimProduct"
						}
					}
				]
			},
			{
				"name": "Copy Stores data to SQL table",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Copy Products data to SQL table",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "upsert",
						"upsertSettings": {
							"useTempDB": true,
							"keys": [
								"StoreID"
							]
						},
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_csv_generic",
						"type": "DatasetReference",
						"parameters": {
							"container": "landing",
							"folder": "source_data/partner_drops/stores",
							"file": "stores.csv"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_sql_table",
						"type": "DatasetReference",
						"parameters": {
							"table_name": "DimStore"
						}
					}
				]
			},
